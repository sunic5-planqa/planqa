{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "outDir": "node_modules/.tsc-node-out",
    "resolveJsonModule": true,

    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "manifest.config.ts", "vitest.config.ts", "package.json"]
}
