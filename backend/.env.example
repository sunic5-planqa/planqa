ANTHROPIC_API_KEY=

# Postgres connection string (e.g. from Neon/Supabase) so documents/teams/team_rules survive a
# redeploy — Render's free plan has an ephemeral filesystem, so without this the local SQLite
# fallback file gets wiped on every deploy there. Leave unset for local dev/tests: falls back to
# a zero-config SQLite file at backend/data/sunnic.db automatically.
DATABASE_URL=

# Comma-separated Gemini API keys for round-robin rotation (Tier-1 QA screening).
# Free-tier quota is low (as little as 5 RPM / 20 requests/day per key) — multiple
# keys let the client rotate on 429 instead of stalling.
GEMINI_API_KEYS=

# Fallback for both screen_llm/confirm_llm when GEMINI_API_KEYS/ANTHROPIC_API_KEY aren't
# ready yet — see qa_jobs.py's _run_review_sync.
OPENAI_API_KEY=

# Optional overrides — defaults are used if unset
SUNNIC_HAIKU_MODEL=claude-haiku-4-5
SUNNIC_SONNET_MODEL=claude-sonnet-5
SUNNIC_GEMINI_MODEL=gemini-flash-lite-latest
SUNNIC_OPENAI_MODEL=gpt-5-mini

# Comma-separated origins allowed to call this API (the Chrome extension's origin).
# This id is pinned by extension/dev-key.public.txt (see extension/scripts/generate-dev-key.mjs)
# so it stays stable across unpacked reloads/rebuilds.
ALLOWED_ORIGINS=chrome-extension://lakdhpgnlleljlkkfobckijbnojlplcf,http://localhost:5173
